<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.forgelabs.daemon.__PROJECT_ID__</string>

    <!-- Issue #955: daemon_prestart_wrapper.sh refuses to start the daemon
         when main branch CI is red — prevents the daemon from churning
         out PRs that cannot merge. Fail-open on check errors; pass-through
         to the original ProgramArguments chain on success.
         The wrapper is installed at ~/Library/Application Support/Forge/
         because macOS TCC blocks launchd from reading scripts under
         ~/Documents (where project checkouts typically live). /bin/bash
         is the first arg because relying on shebang exec is fragile in
         launchd's context.
         WS-119: caffeinate -i prevents macOS idle sleep from killing the
         daemon (App Nap/idle sleep was killing it overnight even with
         ProcessType=Background). caffeinate prevents idle sleep for the
         duration of the wrapped process. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__APPLICATION_SUPPORT_DIR__/Forge/daemon_prestart_wrapper.sh</string>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>__PROJECT_ROOT__/.claude/hooks/company/forge_daemon.py</string>
        <string>start</string>
        <string>--foreground</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- WS-120: StartInterval ensures daemon restarts every 10 minutes,
         preventing overnight unload issues when machine sleeps.
         If daemon dies, KeepAlive will restart it sooner. -->
    <key>StartInterval</key>
    <integer>600</integer>

    <!-- Standard, NOT Background, and NOT Adaptive.

         History: WS-118 set Background specifically to stop launchd applying
         ADAPTIVE resource management, which was SIGTERMing idle processes
         after ~2min. That reasoning still rules out Adaptive. It does not
         require Background: per launchd.plist(5), Standard is equivalent to
         no ProcessType at all and carries none of Adaptive's idle handling.
         The idle-kill problem was separately and directly fixed later by
         WS-119's `caffeinate -i` wrapper (see the ProgramArguments comment
         above), so Background's original justification is now redundant.

         Why it must change: Background places the job in macOS's throttled
         background QoS band, and QoS is INHERITED BY CHILD PROCESSES, so
         every worker session the daemon spawns runs throttled, and with it
         every pytest/ruff/git call those workers make.

         Measured 2026-08-13 on this repo, a representative worker tool
         sequence (ruff over the hooks package + a pytest file + git status
         and log):
             normal QoS       1344ms
             background QoS  25918ms      (taskpolicy -b)
         a 19.3x penalty. That measurement is also the inheritance proof: the
         throttled process was a shell, and uv/pytest/git were its children.
         A full-suite coverage run showed the same effect at 10.2x, which is
         what silently killed the nightly coverage job on all 26 of its runs.

         The tradeoff accepted here: the daemon now competes at normal
         priority. It idles between cycles, so the cost is bursty rather than
         constant, and those bursts are exactly when throttling hurts most. -->
    <key>ProcessType</key>
    <string>Standard</string>

    <!-- WS-110: Give daemon time to finish in-flight tasks before SIGKILL. -->
    <key>ExitTimeOut</key>
    <integer>300</integer>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/.company/logs/daemon-launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/.company/logs/daemon-launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__USER_PATH__</string>
        <key>CLAUDECODE</key>
        <string></string>
        <key>CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS</key>
        <string>__AGENT_TEAMS_ENABLED__</string>
    </dict>
</dict>
</plist>
