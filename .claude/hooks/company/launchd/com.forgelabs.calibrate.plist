<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.forgelabs.calibrate.__PROJECT_ID__</string>

    <!-- One-shot nightly calibration job: Tier-1 gh merged-check + Tier-2
         semantic judgment on new merged PRs since the last snapshot.
         Appends to .company/state/autonomy_audit.json so /dashboard stays
         current and the 'nightly fail-closed calibration' claim is backed
         by a real mechanism.

         Runs at 02:00 UTC daily.  Unlike the daemon plist this is a
         one-shot job (no KeepAlive) so launchd only starts it once per
         calendar interval.

         The claude CLI env follows the same stripping convention as the
         daemon (CLAUDECODE cleared, UV_ / VIRTUAL_ENV stripped by the
         nightly_calibration.py → deliverable_judge → _clean_child_env()
         chain at subprocess spawn time).

         Install: copy this file to
           ~/Library/LaunchAgents/com.forgelabs.calibrate.__PROJECT_ID__.plist
         after substituting all __PLACEHOLDER__ values, then:
           launchctl load ~/Library/LaunchAgents/com.forgelabs.calibrate.__PROJECT_ID__.plist
    -->

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>__PROJECT_ROOT__/bin/forge-calibrate-nightly</string>
        <string>--company-dir</string>
        <string>__PROJECT_ROOT__/.company</string>
        <string>--project-root</string>
        <string>__PROJECT_ROOT__</string>
        <string>--verbose</string>
    </array>

    <!-- Run daily at 02:00 UTC.  No KeepAlive — one-shot. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Give the job enough time to judge up to ~25 PRs
         (300 s/PR × 25 ≈ 125 min; 3600 s is a safe ceiling). -->
    <key>ExitTimeOut</key>
    <integer>3600</integer>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/.company/logs/calibrate-nightly-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/.company/logs/calibrate-nightly-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__USER_PATH__</string>
        <!-- CLAUDECODE must be set (empty) so the Claude CLI recognises it
             is being invoked non-interactively, matching the daemon convention. -->
        <key>CLAUDECODE</key>
        <string></string>
        <key>PYTHONPATH</key>
        <string>__PROJECT_ROOT__</string>
    </dict>
</dict>
</plist>
