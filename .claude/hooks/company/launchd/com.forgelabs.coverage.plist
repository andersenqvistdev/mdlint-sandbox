<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.forgelabs.coverage.__PROJECT_ID__</string>

    <!-- One-shot nightly coverage job: runs the full test suite with
         coverage and writes a trusted coverage.json at the project root
         for the G1 goal assessor (goal_tracker._read_trusted_coverage) to
         read. This replaces letting an LLM worker session attempt a
         full-suite pytest run as a queued task (which cannot finish
         inside one worker session for a large suite and gets correctly
         blocked by the deliverable gate, wasting a queue slot).

         Runs daily at 03:30 (machine-local time — launchd
         StartCalendarInterval always fires in the local timezone; the
         calibrate plist's hour=2 is local for the same reason). That is
         90 minutes after the calibrate job starts, and the pytest ceiling
         is 90 minutes, so the two heavy subprocess trees can never
         overlap regardless of which one runs long. Unlike the daemon
         plist this is a one-shot job (no KeepAlive) so launchd only
         starts it once per calendar interval.

         Install: copy this file to
           ~/Library/LaunchAgents/com.forgelabs.coverage.__PROJECT_ID__.plist
         after substituting all __PLACEHOLDER__ values, then:
           launchctl load ~/Library/LaunchAgents/com.forgelabs.coverage.__PROJECT_ID__.plist
    -->

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>__PROJECT_ROOT__/bin/forge-coverage-nightly</string>
        <string>--company-dir</string>
        <string>__PROJECT_ROOT__/.company</string>
        <string>--project-root</string>
        <string>__PROJECT_ROOT__</string>
        <string>--verbose</string>
    </array>

    <!-- Run daily at 03:30 local time.  No KeepAlive — one-shot. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- MUST be Standard, not Background. ProcessType=Background places the
         job in macOS's throttled background QoS class (CPU deprioritised and
         I/O throttled). That is harmless for an I/O-wait-bound daemon but
         crippling for a compute-bound full-suite coverage run.

         Measured 2026-08-13 on this repo, same 150 tests with coverage:
             normal QoS      5.52s
             background QoS 56.07s   (taskpolicy -b, what launchd applies)
         a 10.2x penalty. The full suite takes 1470s (24m30s) at normal QoS,
         so under background QoS it needs ~4 hours and blew the 5400s ceiling
         on all 26 recorded runs. Every one reported timed_out=true and
         ran=false, which is why coverage.json never existed and G1 assessed
         as 0% for weeks despite real coverage being 84.78%. -->
    <key>ProcessType</key>
    <string>Standard</string>

    <!-- NOTE: ExitTimeOut is NOT a runtime ceiling — it is only the
         SIGTERM->SIGKILL grace launchd allows at unload/shutdown; launchd
         never kills a long-running StartCalendarInterval job. The real
         runtime bounds live in nightly_coverage.py: a 5400s pytest cap
         (process-group SIGKILL on expiry) and a bounded non-blocking lock
         wait (LOCK_NB + retries), so the job itself can never run
         unbounded. -->
    <key>ExitTimeOut</key>
    <integer>120</integer>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/.company/logs/coverage-nightly-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/.company/logs/coverage-nightly-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__USER_PATH__</string>
        <!-- CLAUDECODE must be set (empty) so the Claude CLI recognises it
             is being invoked non-interactively, matching the daemon convention. -->
        <key>CLAUDECODE</key>
        <string></string>
        <key>PYTHONPATH</key>
        <string>__PROJECT_ROOT__</string>
    </dict>
</dict>
</plist>
