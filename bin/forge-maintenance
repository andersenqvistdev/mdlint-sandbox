#!/usr/bin/env python3
"""forge-maintenance — toggle the daemon maintenance lock.

Usage:
  forge-maintenance status                 # Show current state (exit 0/1)
  forge-maintenance on "reason"            # Block daemon start
  forge-maintenance on "reason" --files a.py b.py
  forge-maintenance off                    # Allow daemon start
  forge-maintenance help

Why this exists instead of `rm .company/maintenance_mode.json`:

The maintenance lock is toggled constantly during any daemon-core edit window
(CLAUDE.md's rule: enable it before touching forge_daemon.py, employee_activator.py,
failure_recovery.py or operation_loop.py; always clear it before ending a
session). Clearing it with `rm` trips the `Bash(rm *)` permission rule in
.claude/settings.json on every single use, and `rm` on a path that is one typo
away from something important is the wrong habit to build into a routine
workflow.

This performs the same operation with pathlib.Path.unlink(missing_ok=True):
no shell glob expansion, no recursive flag to fat-finger, and it can be
allowlisted as a single well-understood entry point the way
`Bash(./bin/forge-queue)` already is.

Exit codes:
  0  success (for `status`: maintenance is OFF, i.e. the daemon may start)
  1  for `status`: maintenance is ON
  2  usage error
"""

from __future__ import annotations

import json
import sys
from datetime import datetime, timezone
from pathlib import Path

LOCK_RELATIVE = Path(".company") / "maintenance_mode.json"

USAGE = __doc__.split("Why this exists")[0].strip()


def _lock_path(project_root: Path) -> Path:
    return project_root / LOCK_RELATIVE


def read_state(project_root: Path) -> dict | None:
    """Return the lock contents, or None when maintenance is off.

    A present-but-unparseable lock still counts as ON: a corrupt file must
    fail safe (keep the daemon out), never fail open.
    """
    path = _lock_path(project_root)
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {"enabled": True, "reason": "(unparseable lock file)"}
    return (
        data if isinstance(data, dict) else {"enabled": True, "reason": "(malformed)"}
    )


def turn_on(project_root: Path, reason: str, protected_files: list[str]) -> Path:
    path = _lock_path(project_root)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(
            {
                "enabled": True,
                "reason": reason,
                "protected_files": protected_files,
                "started": datetime.now(timezone.utc).isoformat(),
            },
            indent=2,
        )
        + "\n"
    )
    return path


def turn_off(project_root: Path) -> bool:
    """Remove the lock. Returns True if one was present."""
    path = _lock_path(project_root)
    existed = path.exists()
    path.unlink(missing_ok=True)
    return existed


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in {"help", "-h", "--help"}:
        print(USAGE)
        return 0

    command = args[0]
    root = Path.cwd()

    if command == "status":
        state = read_state(root)
        if state is None:
            print("maintenance mode OFF — daemon may start")
            return 0
        reason = state.get("reason", "(no reason recorded)")
        started = state.get("started", "unknown")
        files = state.get("protected_files") or []
        print(f"maintenance mode ON — {reason}")
        print(f"  since: {started}")
        if files:
            print(f"  protected: {', '.join(files)}")
        return 1

    if command == "on":
        rest = args[1:]
        protected: list[str] = []
        if "--files" in rest:
            idx = rest.index("--files")
            protected = rest[idx + 1 :]
            rest = rest[:idx]
        reason = " ".join(rest).strip()
        if not reason:
            print("error: `on` needs a reason\n", file=sys.stderr)
            print(USAGE, file=sys.stderr)
            return 2
        path = turn_on(root, reason, protected)
        print(f"maintenance mode ON — {reason}")
        print(f"  wrote {path}")
        return 0

    if command == "off":
        if turn_off(root):
            print("maintenance mode OFF — daemon may start")
        else:
            print("maintenance mode already OFF — nothing to clear")
        return 0

    print(f"error: unknown command {command!r}\n", file=sys.stderr)
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
